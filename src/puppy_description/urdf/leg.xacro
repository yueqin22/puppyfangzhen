<?xml version="1.0"?>
<robot name="leg" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Leg macro: 3-DoF (hip_yaw, hip_pitch, knee) -->
  <xacro:macro name="leg" params="prefix side y_offset">

    <!-- X position: front legs at +x, rear legs at -x -->
    <xacro:if value="${side == 'front'}">
      <xacro:property name="x_pos" value="${body_length/2 - 0.02}"/>
    </xacro:if>
    <xacro:unless value="${side == 'front'}">
      <xacro:property name="x_pos" value="${-(body_length/2 - 0.02)}"/>
    </xacro:unless>

    <!-- Hip yaw link (side motor housing) -->
    <link name="${prefix}_hip_yaw_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${hip_radius}" length="${hip_length}"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${hip_radius}" length="${hip_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.3" r="${hip_radius}" l="${hip_length}"/>
    </link>

    <!-- Hip yaw joint (fixed) -->
    <joint name="${prefix}_hip_yaw_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_yaw_link"/>
      <origin xyz="${x_pos} ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.55" upper="0.55" effort="3.0" velocity="4.0"/>
    </joint>

    <!-- Hip pitch link (thigh) -->
    <link name="${prefix}_thigh_link">
      <visual>
        <origin xyz="0 0 ${-L1/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${thigh_radius}" length="${L1}"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-L1/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${thigh_radius}" length="${L1}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${leg_mass}" r="${thigh_radius}" l="${L1}"/>
    </link>

    <!-- Hip pitch joint (fixed) -->
    <joint name="${prefix}_hip_pitch_joint" type="revolute">
      <parent link="${prefix}_hip_yaw_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.35" upper="1.35" effort="3.0" velocity="5.0"/>
    </joint>

    <!-- Calf link (shin) -->
    <link name="${prefix}_calf_link">
      <visual>
        <origin xyz="0 0 ${-L2/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${calf_radius}" length="${L2}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-L2/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${calf_radius}" length="${L2}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${leg_mass * 0.7}" r="${calf_radius}" l="${L2}"/>
    </link>

    <!-- Knee joint (fixed) -->
    <joint name="${prefix}_knee_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_calf_link"/>
      <origin xyz="0 0 ${-L1}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.35" upper="0.15" effort="3.0" velocity="5.0"/>
    </joint>

    <!-- Foot tip (sphere for contact) -->
    <link name="${prefix}_foot_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
        <material name="red"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia m="0.1" r="0.02"/>
    </link>

    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_calf_link"/>
      <child link="${prefix}_foot_link"/>
      <origin xyz="0 0 ${-L2}" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo materials -->
    <gazebo reference="${prefix}_hip_yaw_link">
      <material>Gazebo/Grey</material>
      <mu1>0.3</mu1><mu2>0.3</mu2>
    </gazebo>
    <gazebo reference="${prefix}_thigh_link">
      <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="${prefix}_calf_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${prefix}_foot_link">
      <material>Gazebo/Red</material>
      <mu1>1.0</mu1><mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

  </xacro:macro>

</robot>
