<?xml version="1.0"?>
<robot name="gazebo_control" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gazebo_control" params="use_planar_move:=true">

    <!-- 平面移动插件：直接通过 /cmd_vel 控制 base_link 速度 -->
    <!-- 最小闭环方案：先跑通 SLAM + Nav2，之后再换成足式步态 -->
    <xacro:if value="${use_planar_move}">
    <gazebo>
      <plugin name="planar_move_controller" filename="libgazebo_ros_planar_move.so">
        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <update_rate>50.0</update_rate>
      </plugin>
    </gazebo>
    </xacro:if>

    <xacro:unless value="${use_planar_move}">
      <ros2_control name="PuppyPiSimSystem" type="system">
        <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
        <joint name="FR_hip_yaw_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="FR_hip_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="FR_knee_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="FL_hip_yaw_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="FL_hip_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="FL_knee_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="RR_hip_yaw_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="RR_hip_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="RR_knee_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="RL_hip_yaw_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="RL_hip_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
        <joint name="RL_knee_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
      </ros2_control>
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>$(find puppy_description)/config/controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:unless>

    <!-- Gazebo friction/dynamics for base -->
    <gazebo reference="base_link">
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
      <gravity>true</gravity>
    </gazebo>

    <!-- 禁用所有腿的重力，防止机器人翻倒 -->
    <gazebo reference="FR_hip_yaw_link"><gravity>false</gravity></gazebo>
    <gazebo reference="FL_hip_yaw_link"><gravity>false</gravity></gazebo>
    <gazebo reference="RR_hip_yaw_link"><gravity>false</gravity></gazebo>
    <gazebo reference="RL_hip_yaw_link"><gravity>false</gravity></gazebo>
    <gazebo reference="FR_thigh_link"><gravity>false</gravity></gazebo>
    <gazebo reference="FL_thigh_link"><gravity>false</gravity></gazebo>
    <gazebo reference="RR_thigh_link"><gravity>false</gravity></gazebo>
    <gazebo reference="RL_thigh_link"><gravity>false</gravity></gazebo>
    <gazebo reference="FR_calf_link"><gravity>false</gravity></gazebo>
    <gazebo reference="FL_calf_link"><gravity>false</gravity></gazebo>
    <gazebo reference="RR_calf_link"><gravity>false</gravity></gazebo>
    <gazebo reference="RL_calf_link"><gravity>false</gravity></gazebo>
    <gazebo reference="FR_foot_link"><gravity>false</gravity></gazebo>
    <gazebo reference="FL_foot_link"><gravity>false</gravity></gazebo>
    <gazebo reference="RR_foot_link"><gravity>false</gravity></gazebo>
    <gazebo reference="RL_foot_link"><gravity>false</gravity></gazebo>

  </xacro:macro>

</robot>
