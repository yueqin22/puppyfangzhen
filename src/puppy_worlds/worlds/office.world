<?xml version="1.0"?>
<sdf version="1.7">
  <world name="office">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="libgazebo_ros_init.so" name="gazebo_ros_init">
      <ros><namespace>/</namespace></ros>
    </plugin>

    <plugin filename="libgazebo_ros_state.so" name="gazebo_ros_state">
      <ros><namespace>/</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer walls (20m x 15m office) -->
    <model name="wall_north"><static>true</static><pose>0 7.5 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>20.0 0.2 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link></model>

    <model name="wall_south"><static>true</static><pose>0 -7.5 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>20.0 0.2 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link></model>

    <model name="wall_east"><static>true</static><pose>10 0 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 15.0 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 15.0 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link></model>

    <model name="wall_west"><static>true</static><pose>-10 0 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 15.0 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 15.0 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link></model>

    <!-- Interior partition walls -->
    <model name="partition_1"><static>true</static><pose>-3 3 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>8.0 0.2 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link></model>

    <model name="partition_2"><static>true</static><pose>3 -2 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 8.0 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 8.0 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link></model>

    <!-- Furniture: desks (cylinders) -->
    <model name="desk_1"><static>true</static><pose>5 5 0.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.9 1</ambient><diffuse>0.3 0.3 0.9 1</diffuse></material></visual></link></model>

    <model name="desk_2"><static>true</static><pose>-5 -5 0.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.9 1</ambient><diffuse>0.3 0.3 0.9 1</diffuse></material></visual></link></model>

    <!-- Chair obstacles (small boxes) -->
    <model name="chair_1"><static>true</static><pose>2 3 0.4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.8</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual></link></model>

    <model name="chair_2"><static>true</static><pose>-2 -3 0.4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.8</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual></link></model>

    <model name="chair_3"><static>true</static><pose>6 -4 0.4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.8</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual></link></model>

  </world>
</sdf>
